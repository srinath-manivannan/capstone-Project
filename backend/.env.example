# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file - make sure .gitignore includes it.

PORT=5000

# Your MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=your_mongodb_connection_string_here

# Any long random string - used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

JWT_EXPIRES_IN=7d

# Your frontend's URL, so the backend only accepts requests from it
CLIENT_URL=http://localhost:5173

NODE_ENV=development